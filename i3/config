set $mod Mod4

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
# font pango:DejaVu Sans Book 10

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).

# set configs for high dpi in .Xresources first!
# font pango:JetBrains Mono 11.25
# font pango:DejaVuSansMono NF 11
# font pango:Ubuntu Sans, ExtraBold 11
font pango:Ubuntu Sans, Medium 9.5
# font pango:FontAwesome, Regular 11

# Before i3 v4.8, we used to recommend this one as the default:
# font -misc-fixed-medium-r-normal--13-120-75-75-C-70-iso10646-1
# The font above is very space-efficient, that is, it looks good, sharp and
# clear in small sizes. However, its unicode glyph coverage is limited, the old
# X core fonts rendering does not support right-to-left and this being a bitmap
# font, it doesn’t scale on retina/hidpi displays.
#
workspace_layout stacking
workspace_auto_back_and_forth yes
bindsym $mod+z workspace back_and_forth

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

bindsym Ctrl+Shift+space exec --no-startup-id dunstctl close
# bindsym Ctrl+Shift+space exec --no-startup-id dunstctl close-all

# start a terminal
bindsym $mod+Return exec alacritty
bindsym $mod+Shift+Return exec --no-startup-id alacritty -e zsh -ci ranger
bindsym $mod+Shift+i exec --no-startup-id alacritty -e bash -ci btop
bindsym $mod+Shift+m workspace 9; exec --no-startup-id alacritty -e zsh -ci ncmpcpp

bindsym $mod+y exec --no-startup-id alacritty --title 'fzf-menu' -e bash -ifc 'i3-dmenu-desktop --dmenu=fzf'
for_window [title="fzf-menu"] floating enable
for_window [floating] move position center
for_window [class="^jetbrains-.*" window_type="dialog"] move position center

# kill focused window
bindsym $mod+Shift+q kill

# There also is the (new) i3-dmenu-desktop which only displays applications
# shipping a .desktop file. It is a wrapper around dmenu, so you need that
# installed.
# bindsym $mod+d exec --no-startup-id i3-dmenu-desktop

default_border normal 1
for_window [all] title_window_icon padding 3
default_floating_border normal 1

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+i split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# switch to workspace
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# set $monitor HDMI1
# set $notebook LVDS1
# workspace $workspace1 output $monitor
# workspace $workspace2 output $monitor
# workspace $workspace3 output $monitor
# workspace $workspace4 output $monitor
# workspace $workspace9 output $monitor
# workspace $workspace10 output $monitor
# workspace 8 output $notebook

# reload the configuration file
bindsym $mod+Shift+c reload
# bindsym $mod+Shift+c exec "cat .config/i3/colors .config/i3/base > .config/i3/config && i3-msg reload"
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -b 'Yes, exit i3' 'i3-msg exit'"

set $rs 5 

# resize window (you can also use the mouse for that)
mode "resize" {
        bindsym l resize grow width $rs px or $rs ppt
        bindsym k resize grow height $rs px or $rs ppt
        bindsym j resize shrink height $rs px or $rs ppt
        bindsym h resize shrink width $rs px or $rs ppt

        bindsym Right resize shrink width 10 px or 10 ppt
        bindsym Up resize grow height 10 px or 10 ppt
        bindsym Down resize shrink height 10 px or 10 ppt
        bindsym Left resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# --- status bar ---
exec_always --no-startup-id ~/dotfiles/polybar/launch.sh
# open app
bindsym $mod+Tab exec "rofi -show window"
# app switcher
bindsym $mod+d exec "rofi -show combi -combi-modi drun,run -modi combi"
# translate selected text
bindsym $mod+t exec $HOME/dotfiles/scripts/seltr
bindsym $mod+p exec $HOME/dotfiles/scripts/clptr
bindsym $mod+n exec nautilus

# volume/brightness go through scripts/osd: same wpctl/brightnessctl call
# plus a dunst progress-bar popup.
bindsym XF86MonBrightnessUp exec --no-startup-id $HOME/dotfiles/scripts/osd bright up
bindsym XF86MonBrightnessDown exec --no-startup-id $HOME/dotfiles/scripts/osd bright down
bindsym XF86AudioRaiseVolume exec --no-startup-id $HOME/dotfiles/scripts/osd vol up
bindsym XF86AudioLowerVolume exec --no-startup-id $HOME/dotfiles/scripts/osd vol down
bindsym XF86AudioMute exec --no-startup-id $HOME/dotfiles/scripts/osd vol mute
bindsym XF86ScreenSaver exec --no-startup-id loginctl lock-session
bindsym XF86Sleep exec --no-startup-id systemctl suspend
bindsym XF86Battery exec --no-startup-id xset dpms force off

bindsym Print exec flameshot gui -p ~/Pictures

# turn off graphic card
# exec --no-startup-id gksudo ~/work/scripts/cards.sh

# decrease dimension for acceptable views of some programs
# exec xrandr --dpi 120

# set wallpaper
exec_always feh --bg-fill ~/dotfiles/i3/wallpaper.jpg

# network manager applet
exec --no-startup-id nm-applet

# bluetooth applet
exec --no-startup-id blueman-applet

# composite manager (ex: transparent backgound)
# exec_always, not exec: a crashed picom must come back on $mod+Shift+r,
# otherwise alacritty's opacity silently stops working.
exec_always --no-startup-id picom -b

# screen lock: the X idle timer arms the screensaver, xss-lock turns that — and
# logind's Lock / PrepareForSleep signals — into a real i3lock. pkill first:
# exec_always would otherwise stack a second instance on every reload.
exec_always --no-startup-id xset s 600 610
exec_always --no-startup-id "pkill -x xss-lock; exec xss-lock --transfer-sleep-lock -- i3lock -n -c 1d2021"

# kbdd (per-window keyboard layout) is started below, in the xkbcomp chain, not
# here: it reads the XKB group names once at startup and caches them. Started
# against the one-group keymap X boots with, it has no name for group 2, so the
# polybar indicator goes blank every time Russian is active.

# certs
exec --no-startup-id gnome-keyring-daemon

# unclutter makes the mouse invisible after a brief period
exec --no-startup-id unclutter

# CapsLock mapping with delay - to let X apply own configs and then rewrite.
# kbdd is started in the same chain, after the keymap, and only when it cannot
# name the second group — so an i3 reload does not needlessly drop its
# per-window layout map.
exec_always "sleep 3 && xkbcomp $HOME/dotfiles/xkb/my $DISPLAY; dbus-send --print-reply --reply-timeout=2000 --dest=ru.gentoo.KbddService /ru/gentoo/KbddService ru.gentoo.kbdd.getLayoutName uint32:1 >/dev/null 2>&1 || { pkill -x kbdd; while pgrep -x kbdd >/dev/null; do sleep 0.2; done; kbdd; }"

assign [class="google-chrome"] 2
assign [class="firefox"] 2
assign [class="Insomnia"] 2
assign [class="Thunderbird"] 3

assign [class="Skype"] 4
assign [class="Slack"] 4
assign [class="zoom"] 4
assign [class="Telegram"] 4

assign [class="jetbrains-idea"] 10
assign [class="jetbrains-clion"] 10
assign [class="jetbrains-pycharm"] 10

for_window[class="gnome-calculator"] floating enabled
for_window[class="app.hiddify.com"] floating enabled

